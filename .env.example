# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Weather API Configuration
# Get your free API key from https://openweathermap.org/api
VITE_WEATHER_API_KEY=your_openweathermap_api_key_here
VITE_WEATHER_LOCATION=London

# Server Configuration
PORT=3000

# GitHub Webhook Auto-Update (Optional)
# Generate a secret here: https://github.com/your-repo/settings/hooks
# Add it to GitHub webhook settings and here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Dashboard Directory (Optional, defaults to ~/home-dashboard)
DASHBOARD_DIR=/home/pi/home-dashboard
